<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net7.0-windows</TargetFramework>
    <UseWPF>false</UseWPF>
    <AssemblyName>ParametricFasteners</AssemblyName>
    <AssemblyTitle>参数化紧固件</AssemblyTitle>
    <Product>参数化紧固件</Product>
    <RootNamespace>RhinoMM.Plugin</RootNamespace>
    <Version>0.3.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\RhinoMM.Core\RhinoMM.Core.csproj" />
    <!-- Compile against the oldest supported Rhino service release. Newer Rhino 8 builds can load it. -->
    <PackageReference Include="RhinoCommon" Version="8.18.25098.11001" NoWarn="NU1701" />
    <PackageReference Include="Eto.Forms" Version="2.8.3" />
    <PackageReference Include="System.Drawing.Common" Version="7.0.0" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="CreateRhp" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(TargetDir)参数化紧固件.rhp" />
  </Target>
</Project>
